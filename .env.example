# Copy of the labels in .env.local, with no values. This file is safe to upload.
# Real keys go only in .env.local, which is never uploaded.

# Supabase: the database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=

# Supabase: a separate project for tests only
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=

# Stripe: test mode only. Keys must start with pk_test_ and sk_test_ or rk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend: email. The inbox must be the address on the Resend account
RESEND_API_KEY=
DEMO_INBOX_EMAIL=

# Anthropic: the chatbot
ANTHROPIC_API_KEY=

# Long random strings. These are generated, so you never need to touch them
IP_HASH_SALT=
CRON_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
SITE_URL=
STRIPE_LIVE_WEBHOOK_SECRET=
