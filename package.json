{
  "name": "demo-plumbers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "eval:chat": "vitest run --config vitest.eval.config.ts",
    "verify": "eslint src scripts e2e && tsc --noEmit && vitest run && node scripts/scan-secrets.mjs && next build",
    "e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@opennextjs/cloudflare": "1.20.15",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.37.0",
    "stripe": "23.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
